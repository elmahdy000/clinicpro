*.zip
next_build.zip
web/next_build.zip

# ── Environment files (NEVER commit these) ───────────────────────────────────
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Uploads (user files, not source code) ────────────────────────────────────
uploads/
!uploads/.gitkeep

# ── Cache & temp files ────────────────────────────────────────────────────────
.graphify_temp/
graphify-out/
api/graphify-out/
.cache/
*.cache

# ── Scratch / throwaway scripts ───────────────────────────────────────────────
