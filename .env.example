DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/clinicpro

# Access token secret (15 min expiry). REQUIRED.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_secret

# Refresh token secret — REQUIRED and MUST be a DIFFERENT value from JWT_SECRET.
# The app refuses to issue refresh tokens if this is unset.
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_DIFFERENT_random_64_char_secret

PORT=3000
FRONTEND_URL=http://localhost:3001
